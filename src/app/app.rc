#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Nvidia App Cleaner\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "NvidiaAppCleaner\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 JonDoe828\0"
            VALUE "OriginalFilename", "NvidiaAppCleaner.exe\0"
            VALUE "ProductName", "Nvidia App Cleaner\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Storage cleanup", IDM_VIEW_CLEANUP
        MENUITEM "&Download repair", IDM_VIEW_REPAIR
        MENUITEM "&Settings", IDM_VIEW_SETTINGS
        MENUITEM SEPARATOR
        POPUP "&Language"
        BEGIN
            MENUITEM "&English", IDM_LANGUAGE_ENGLISH
            MENUITEM "简体中文(&C)", IDM_LANGUAGE_SIMPLIFIED_CHINESE
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Nvidia App Cleaner", IDM_HELP_ABOUT
    END
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "退出(&X)", IDM_FILE_EXIT
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "存储清理(&C)", IDM_VIEW_CLEANUP
        MENUITEM "下载修复(&R)", IDM_VIEW_REPAIR
        MENUITEM "设置(&S)", IDM_VIEW_SETTINGS
        MENUITEM SEPARATOR
        POPUP "语言(&L)"
        BEGIN
            MENUITEM "English(&E)", IDM_LANGUAGE_ENGLISH
            MENUITEM "简体中文(&C)", IDM_LANGUAGE_SIMPLIFIED_CHINESE
        END
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于 Nvidia App Cleaner(&A)", IDM_HELP_ABOUT
    END
END
