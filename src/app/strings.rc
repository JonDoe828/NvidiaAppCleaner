    IDS_SUMMARY_SELECTED_PREFIX "Selected: "
    IDS_STATUS_SCAN_COMPLETE "Scan complete. No files were changed."
    IDS_CURRENT_DRIVER_SCANNING "Current NVIDIA driver: reading..."
    IDS_CURRENT_DRIVER_PREFIX "Current NVIDIA driver: "
    IDS_CURRENT_DRIVER_NOT_DETECTED "Current NVIDIA driver: not detected"
    IDS_PACKAGE_VERSIONS_PREFIX "Driver package: "
    IDS_NAVIGATION_REPAIR "Download repair"
    IDS_REPAIR_PAGE_DESCRIPTION "Repairs only NVIDIA App records that are stuck at 100% after a completed driver installer was lost. It never runs automatically or cleans other files."
    IDS_REPAIR_CANDIDATES_NONE "No broken download record was found."
    IDS_REPAIR_CANDIDATES_COUNT_PREFIX "Repairable records: "
    IDS_CLEANUP_GROUP_RECOMMENDED "Recommended cleanup (selected by default)"
    IDS_CLEANUP_GROUP_OPTIONAL "Optional cleanup"
    IDS_CLEANUP_GROUP_ROLLBACK_DRIVERS "Rollback drivers"
